{
    "name": "nowo-tech/transaction-contract",
    "description": "Framework-free transaction port: TransactionRunnerInterface::run(callable), the TransientStorageFailure exception with a Retry-After hint, and the conflict types (ConflictCode, TransientFailureKind, ConcurrencyConflict, LockConflictExceptionInterface). No dependencies beyond PHP: no Symfony, no Doctrine.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contracts",
        "transaction",
        "unit-of-work",
        "retry",
        "deadlock",
        "port",
        "hexagonal",
        "ddd"
    ],
    "homepage": "https://github.com/nowo-tech/transaction-contract",
    "support": {
        "issues": "https://github.com/nowo-tech/transaction-contract/issues",
        "source": "https://github.com/nowo-tech/transaction-contract"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "igor-php/igor-php": "^0.10.0 || ^0.11.0",
        "nowo-tech/phpstan-frankenphp": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\TransactionContract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\TransactionContract\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit --color=always",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --colors=always --coverage-text --coverage-clover coverage.xml",
        "igor": "igor-php --no-agent .",
        "rector": "rector process",
        "test-coverage-100": [
            "@test-coverage",
            "php -r '$m = simplexml_load_file(\"coverage.xml\")->project->metrics; $s = (int) $m[\"statements\"]; $c = (int) $m[\"coveredstatements\"]; echo \"lines $c/$s\\n\"; exit($s > 0 && $c === $s ? 0 : 1);'"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "phpstan": "Run PHPStan static analysis",
        "rector-dry": "Run Rector in dry-run mode",
        "qa": "Run all quality assurance checks",
        "test-coverage": "Run PHPUnit with code coverage",
        "igor": "Run the Igor worker-state audit (REQ-CS-008)",
        "rector": "Apply Rector refactoring",
        "test-coverage-100": "Fail below 100% line coverage of src/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor",
            "/.github",
            "/.githooks",
            "/.scripts",
            "/.specify",
            "/specs",
            "/tests",
            "/docker-compose.yml",
            "/Dockerfile",
            "/Makefile"
        ]
    }
}
